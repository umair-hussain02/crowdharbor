# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/crowdharbor?schema=public"

# SMTP / Nodemailer (server-only, never expose with NEXT_PUBLIC_)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sender shown on outgoing emails
MAIL_FROM="CrowdHarbor <no-reply@crowdharbor.com>"

# Inbox that receives new intake notifications
ADMIN_NOTIFICATION_EMAIL=

# Admin login bootstrap (server-only) — used once by POST /api/admin/auth/bootstrap
# to create the first AdminUser row, then safe to delete/blank out.
# ADMIN_INITIAL_PASSWORD is never stored as-is; it's hashed before being saved.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
